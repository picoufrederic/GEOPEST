#format long
df_long<-resmal%>%
  mutate(row_id = row_number()) %>%
  pivot_longer(
    cols=5:52,
    names_to = "variable",
    values_to = "group"
  )


##POUR IFT
results <- df_long %>%
  mutate(y = df_long[[2]]) %>%
  filter(!is.na(group), !is.na(y)) %>%
  group_by(variable) %>%
  summarise(
    mean_oui = mean(y[group == "oui"], na.rm = TRUE),
    mean_non = mean(y[group == "non"], na.rm = TRUE),
    FC = mean_oui / mean_non,
    log2FC = log2(FC),
    p_value = ifelse(
      length(unique(group)) < 2 |
        any(table(group) < 2),
      NA,
      t.test(y ~ group)$p.value
    ),
    .groups = "drop"
  ) %>%
  mutate(
    p_adj = p.adjust(p_value, method = "none"),
    minus_log10_p = -log10(p_value),
    significant=p_adj < 0.05
    
  )
resIFT<-cbind(results$variable, results$FC, results$p_value)

