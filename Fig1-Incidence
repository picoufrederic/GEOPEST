y_max <- max(agg$inc_hi_100k, na.rm = TRUE)
y_lim_top <- max(10, ceiling(y_max * 1.15 * 10) / 10)


cols <- c("Q1_Q2"="darkgreen", "Q3_Q4"="firebrick")


gg <- ggplot(agg, aes(x=expo_grp, y=inc_100k)) +
  geom_errorbar(aes(ymin=inc_lo_100k, ymax=inc_hi_100k),
                width=0.15, linewidth=1) +
  geom_point(aes(color=expo_grp), size=4) +
  geom_text(
    data=agg %>% filter(expo_grp=="Q1_Q2"),
    aes(x=expo_grp, y=inc_100k + 0.05 * y_lim_top),
    label="Ref.",
    inherit.aes=FALSE,
    size=4
  ) +
  geom_text(
    data=agg %>% filter(expo_grp=="Q3_Q4"),
    aes(x=expo_grp, y=inc_hi_100k + 0.05 * y_lim_top),
    label=annot,
    inherit.aes=FALSE,
    size=4
  ) +
  scale_color_manual(values=cols, guide="none") +
  scale_x_discrete(labels=c(Q1_Q2="Q1–Q2", Q3_Q4="Q3–Q4")) +
  scale_y_continuous(limits=c(0, y_lim_top)) +
  labs(
    title="Incidence de LAM selon l'IFT communal",
    subtitle="Comparaison Q1–Q2 vs Q3–Q4 ; points = incidence annuelle (/100 000/an) ; barres = IC95% Poisson ; RR vs Q1–Q2",
    x=NULL,
    y="Incidence annuelle LAM (/100 000/an)"
  ) +
  theme_classic(base_size=13)


print(gg)


ggsave(
  file.path(res_dir, "figure_Q1Q2_vs_Q3Q4.png"),
