read_any <- function(path){
  ext <- tolower(tools::file_ext(path))
  if (ext %in% c("xls","xlsx")) {
    return(readxl::read_excel(path) |> janitor::clean_names())
  } else if (ext %in% c("csv")) {
    return(suppressWarnings(readr::read_csv(path, show_col_types = FALSE, guess_max = 1e5)) |> janitor::clean_names())
  } else if (ext %in% c("tsv","txt")) {
    return(suppressWarnings(readr::read_delim(path, delim = "\t", show_col_types = FALSE, guess_max = 1e5)) |> janitor::clean_names())
  } else stop("❌ Format non supporté: ", ext)
}


norm_key <- function(x){
  z <- iconv(x, to = "ASCII//TRANSLIT")
  z <- tolower(gsub("[^a-z0-9]+", "", z))
  z
}


find_column <- function(df_names, targets){
  nn <- norm_key(df_names)
  tt <- norm_key(targets)
  
  hit <- which(nn %in% tt)
  if (length(hit)) return(df_names[hit[1]])
  
  pattern <- paste(tt, collapse="|")
  hit2 <- which(grepl(pattern, nn))
  if (length(hit2)) return(df_names[hit2[1]])
  
  NA_character_
}


to_num <- function(x){
  if (is.numeric(x)) return(x)
  s <- as.character(x)
  s <- gsub("\u00A0", "", s)
  s <- gsub("\u202F", "", s)
  s <- gsub("[[:space:]]+", "", s)
  s <- gsub("'", "", s)
  s <- gsub(",", ".", s)
  s <- gsub("[^0-9.\\-]+", "", s)
  suppressWarnings(as.numeric(s))
}


to_year <- function(x){
  if (is.numeric(x)) {
    if (all(is.na(x) | (x >= 1900 & x <= 2100))) return(as.integer(x))
    dd <- suppressWarnings(as.Date(x, origin = "1899-12-30"))
    return(suppressWarnings(as.integer(lubridate::year(dd))))
  }
  s <- stringr::str_squish(as.character(x))
  yy1 <- suppressWarnings(as.integer(s))
  ok1 <- !is.na(yy1) & yy1 >= 1900 & yy1 <= 2100
  if (any(ok1)) {
    out <- rep(NA_integer_, length(s))
    out[ok1] <- yy1[ok1]
    rest <- which(!ok1)
    if (length(rest)) {
      dd <- suppressWarnings(lubridate::dmy(s[rest]))
      if (all(is.na(dd))) dd <- suppressWarnings(lubridate::ymd(s[rest]))
      out[rest] <- suppressWarnings(as.integer(lubridate::year(dd)))
    }
    return(out)
  }
  dd <- suppressWarnings(lubridate::dmy(s))
  if (all(is.na(dd))) dd <- suppressWarnings(lubridate::ymd(s))
  suppressWarnings(as.integer(lubridate::year(dd)))
}


pad_cp <- function(x){
  x <- stringr::str_squish(as.character(x))
  x <- gsub("\\.0$", "", x)
  x <- gsub("[^0-9]", "", x)
  ifelse(is.na(x) | x=="", NA_character_, stringr::str_pad(x, 5, pad="0"))
}


# =========================
# 2) Helpers : construire la POPULATION joignable
# =========================
find_col <- function(nms, targets){
  nn <- tolower(gsub("[^a-z0-9]+","", nms))
  tt <- tolower(gsub("[^a-z0-9]+","", targets))
  
  hit <- which(nn %in% tt)
  if (length(hit)) return(nms[hit[1]])
  
  pat <- paste(tt, collapse="|")
  hit2 <- which(grepl(pat, nn))
  if (length(hit2)) return(nms[hit2[1]])
  
  NA_character_
}


read_insee_csv_robust <- function(path){
  x1 <- try(suppressWarnings(readr::read_csv(path, show_col_types = FALSE)), silent = TRUE)
  if (!inherits(x1, "try-error") && ncol(x1) > 1) return(janitor::clean_names(x1))
  
  x2 <- try(suppressWarnings(readr::read_delim(
    path, delim = ";", show_col_types = FALSE, locale = locale(decimal_mark = ",")
  )), silent = TRUE)
  if (!inherits(x2, "try-error") && ncol(x2) > 1) return(janitor::clean_names(x2))
  
  x3 <- try(suppressWarnings(readr::read_delim(path, delim = "\t", show_col_types = FALSE)), silent = TRUE)
  if (!inherits(x3, "try-error") && ncol(x3) > 1) return(janitor::clean_names(x3))
  
  stop("❌ Impossible de lire correctement le CSV INSEE.")
}


build_population_commune_cp <- function(out_dir){
  dir.create(file.path(out_dir, "POP_BUILD_TMP"), showWarnings = FALSE, recursive = TRUE)
  tmp_dir <- file.path(out_dir, "POP_BUILD_TMP")
  
  insee_zip_url <- "https://www.insee.fr/fr/statistiques/fichier/8680726/ensemble.zip"
  cp_csv_url    <- "https://www.data.gouv.fr/api/1/datasets/r/008a2dda-2c60-4b63-b910-998f6f818089"
  
  insee_zip <- file.path(tmp_dir, "insee_pop_ensemble.zip")
  cp_csv    <- file.path(tmp_dir, "base_officielle_codes_postaux.csv")
  out_pop   <- file.path(out_dir, "population_commune_cp.csv")
  
  # --- INSEE ---
  message("⬇️ [POP] Téléchargement INSEE ensemble.zip…")
  utils::download.file(insee_zip_url, destfile = insee_zip, mode = "wb", quiet = TRUE)
  message("📦 [POP] Extraction INSEE…")
  insee_files <- utils::unzip(insee_zip, exdir = tmp_dir)
  
  csv_candidates <- insee_files[grepl("\\.csv$", insee_files, ignore.case = TRUE)]
  if (length(csv_candidates) == 0) stop("❌ [POP] Aucun CSV trouvé dans le ZIP INSEE.")
  
  prefer <- csv_candidates[grepl("commune|communes", basename(csv_candidates), ignore.case = TRUE)]
  csv_main <- if (length(prefer) > 0) prefer[which.max(file.info(prefer)$size)] else csv_candidates[which.max(file.info(csv_candidates)$size)]
  
  message("📄 [POP] Lecture INSEE : ", basename(csv_main))
  insee_raw <- read_insee_csv_robust(csv_main)
  
  nms <- names(insee_raw)
  col_insee <- find_col(nms, c("codgeo","depcom","codecommune","code_commune","code_insee","insee","com"))
  col_lib   <- find_col(nms, c("libgeo","nom_commune","commune","libelle","nom"))
  col_pmun  <- find_col(nms, c("pmun","popmun","population_municipale","pop_mun"))
  col_ptot  <- find_col(nms, c("ptot","poptot","population_totale","pop_tot"))
  col_pop_simple <- find_col(nms, c("population","pop"))
  
  if (is.na(col_insee)) stop("❌ [POP] INSEE: colonne code commune (CODGEO) non détectée.")
  pop_col <- dplyr::coalesce(col_pmun, col_ptot, col_pop_simple)
  if (is.na(pop_col)) stop("❌ [POP] INSEE: colonne population non détectée (PMUN/PTOT/POP).")
  
  message("✅ [POP] INSEE: code=", col_insee, " ; nom=", ifelse(is.na(col_lib), "NA", col_lib), " ; pop=", pop_col)
  
  insee_communes <- insee_raw |>
    mutate(
      code_insee  = stringr::str_pad(toupper(stringr::str_squish(as.character(.data[[col_insee]]))), 5, pad="0"),
      commune_nom = if (!is.na(col_lib)) stringr::str_squish(stringr::str_to_upper(as.character(.data[[col_lib]]))) else NA_character_,
      population  = suppressWarnings(as.numeric(.data[[pop_col]]))
    ) |>
    filter(!is.na(code_insee), code_insee != "",
           !is.na(population), population > 0) |>
    select(code_insee, commune_nom, population) |>
    distinct()
  
  if (nrow(insee_communes) == 0) stop("❌ [POP] INSEE: 0 lignes communes après filtrage.")
  message("🏙️ [POP] Communes INSEE retenues : ", nrow(insee_communes))
  
  # --- CP La Poste ---
  message("⬇️ [POP] Téléchargement Base officielle des codes postaux…")
  utils::download.file(cp_csv_url, destfile = cp_csv, mode = "wb", quiet = TRUE)
  
  message("📄 [POP] Lecture CP↔INSEE (delim=';')…")
  cp_raw <- suppressWarnings(
    readr::read_delim(
      cp_csv,
      delim = ";",
      show_col_types = FALSE,
      locale = readr::locale(encoding = "ISO-8859-1")
    )
  ) |> janitor::clean_names()
  
  n2 <- names(cp_raw)
  cp_insee_col <- find_col(n2, c("code_commune_insee","codeinsee","insee","codgeo","depcom","com"))
  cp_cp_col    <- find_col(n2, c("code_postal","cp","postal_code"))
  cp_nom_col   <- find_col(n2, c("nom_commune","commune","libelle_acheminement","nom"))
  
  if (is.na(cp_insee_col) || is.na(cp_cp_col)) {
    message("📌 [POP] Colonnes CP (aperçu) :"); print(head(names(cp_raw), 60))
    stop("❌ [POP] CP: impossible de trouver (code_insee + code_postal).")
  }
  
  cp_map <- cp_raw |>
    mutate(
      code_insee  = stringr::str_pad(toupper(stringr::str_squish(as.character(.data[[cp_insee_col]]))), 5, pad="0"),
      code_postal = stringr::str_pad(gsub("[^0-9]","", as.character(.data[[cp_cp_col]])), 5, pad="0"),
      commune_nom_cp = if (!is.na(cp_nom_col)) stringr::str_squish(stringr::str_to_upper(as.character(.data[[cp_nom_col]]))) else NA_character_
    ) |>
    filter(!is.na(code_insee), code_insee != "",
           !is.na(code_postal), code_postal != "") |>
    select(code_postal, code_insee, commune_nom_cp) |>
    distinct()
  
  message("📮 [POP] Paires CP–INSEE : ", nrow(cp_map))
  
  pop_commune_cp <- cp_map |>
    left_join(insee_communes, by = "code_insee") |>
    mutate(commune_nom = dplyr::coalesce(commune_nom, commune_nom_cp)) |>
    select(code_postal, code_insee, commune_nom, population) |>
    filter(!is.na(population), population > 0)
  
  message("✅ [POP] Lignes finales avec population : ", nrow(pop_commune_cp))
  if (nrow(pop_commune_cp) == 0) {
    stop("❌ [POP] Fusion CP–INSEE vs INSEE population -> 0 ligne. Vérifie les codes INSEE.")
  }
  
  readr::write_csv(pop_commune_cp, out_pop)
  message("✅ [POP] Fichier population créé : ", out_pop)
  out_pop
}


