# 5) Lecture cohorte + population
# =========================
coh_raw <- read_any(coh_path)
pop_raw <- read_any(pop_path)


message("\n📌 Colonnes COHORTE :"); print(names(coh_raw))
message("\n📌 Colonnes POPULATION :"); print(names(pop_raw))


# =========================
# 6) Détection colonnes cohorte
# =========================
cnc <- names(coh_raw)
col_statut <- find_column(cnc, c("statut","groupe","case_control","cas_temoin"))
col_cp     <- find_column(cnc, c("code_postal","cp","postal_code","codepostal"))
col_com    <- find_column(cnc, c("commune","ville","nom_commune","libelle"))
col_year   <- find_column(cnc, c("annee_diagnostic","annee_diag","year_diag","date_diag","date_diagnostic","date_du_diagnostic","diagnostic_date"))
col_patho  <- find_column(cnc, c("pathologie","diagnostic","maladie"))
col_amltyp <- find_column(cnc, c("aml_type","type_aml","amltype"))
col_ift    <- find_column(cnc, c("ift_total","ift","iftglobal","ift_tot","ift_total_commune","ift_hors_herbicide","ift_herbicide"))


if (is.na(col_cp))  stop("❌ Cohorte: je ne trouve pas la colonne code_postal.")
if (is.na(col_ift)) stop("❌ Cohorte: je ne trouve pas de colonne IFT continue (ex: ift_total).")
if (is.na(col_statut) && is.na(col_patho) && is.na(col_amltyp)) {
  stop("❌ Cohorte: pas de colonnes pour classifier LAM/CONTROLE (statut/pathologie/aml_type).")
}


# =========================
# 7) Nettoyage cohorte + groupe + quartiles IFT -> expo_grp
# =========================
coh <- coh_raw %>%
  mutate(
    code_postal  = pad_cp(.data[[col_cp]]),
    commune_nom  = if (!is.na(col_com)) str_squish(str_to_upper(as.character(.data[[col_com]]))) else NA_character_,
    annee_diag   = if (!is.na(col_year)) to_year(.data[[col_year]]) else NA_integer_,
    
    statut_clean = if (!is.na(col_statut)) str_to_lower(as.character(.data[[col_statut]])) else NA_character_,
    patho_clean  = if (!is.na(col_patho))  str_to_lower(as.character(.data[[col_patho]]))  else NA_character_,
    amltype_clean= if (!is.na(col_amltyp)) str_to_lower(as.character(.data[[col_amltyp]])) else NA_character_,
    
    groupe = case_when(
      !is.na(statut_clean) & str_detect(statut_clean, "cont|temoin|t[eé]moin|control|contr") ~ "CONTROLE",
      !is.na(statut_clean) & str_detect(statut_clean, "\\bcas\\b|patient") ~ "LAM",
      !is.na(patho_clean)  & str_detect(patho_clean, "lam|aml") ~ "LAM",
      !is.na(amltype_clean) & amltype_clean != "" ~ "LAM",
      TRUE ~ NA_character_
    ),
    is_lam = ifelse(groupe == "LAM", 1L, 0L),
    
    ift_val = to_num(.data[[col_ift]])
  ) %>%
  filter(!is.na(code_postal)) %>%
  filter(!is.na(groupe)) %>%
  filter(!is.na(ift_val))


if (nrow(coh) == 0) stop("❌ Après nettoyage, la cohorte est vide (statut/pathologie/ift).")


qcuts <- suppressWarnings(quantile(coh$ift_val, probs = c(0, 0.25, 0.5, 0.75, 1), na.rm = TRUE, type = 7))
if (length(unique(qcuts)) < 3) stop("❌ Impossible de créer des quartiles IFT (variance trop faible).")


coh <- coh %>%
  mutate(
    quartile_ift = case_when(
      ift_val <= qcuts[2] ~ "Q1",
      ift_val <= qcuts[3] ~ "Q2",
      ift_val <= qcuts[4] ~ "Q3",
      TRUE ~ "Q4"
    ),
    expo_grp = case_when(
      quartile_ift %in% c("Q1","Q2") ~ "Q1_Q2",
      quartile_ift %in% c("Q3","Q4") ~ "Q3_Q4",
      TRUE ~ NA_character_
    )
  )


message("\n✔ Effectifs cohorte :"); print(table(coh$groupe))
message("\n✔ Expo (Q1_Q2 vs Q3_Q4) :"); print(table(coh$expo_grp))
message("\n✔ Coupes quartiles IFT :"); print(qcuts)


# =========================
# 8) Période (années)
# =========================
ok_year <- !is.na(coh$annee_diag) & coh$annee_diag >= 1900 & coh$annee_diag <= 2100
prop_year <- mean(ok_year)
if (is.na(prop_year)) prop_year <- 0


if (prop_year >= 0.5) {
  y_min <- min(coh$annee_diag[ok_year], na.rm=TRUE)
  y_max <- max(coh$annee_diag[ok_year], na.rm=TRUE)
  nb_years <- y_max - y_min + 1
  periode_txt <- paste0(y_min, "-", y_max, " (", nb_years, " ans)")
} else {
  message("\n⚠️ Année diagnostic insuffisante. Donne la durée de suivi (années).")
  nb_years <- as.numeric(readline("Durée (années) = "))
  if (is.na(nb_years) || nb_years <= 0) stop("❌ Durée invalide.")
  periode_txt <- paste0("durée fournie par l'utilisateur: ", nb_years, " ans")
}
message("🕒 Période utilisée : ", periode_txt)


# =========================
# 9) Agrégation cas LAM par expo_grp + CP + commune
# =========================
lam_by <- coh %>%
  group_by(expo_grp, code_postal, commune_nom) %>%
  summarise(
    n_LAM = sum(is_lam, na.rm=TRUE),
    n_total_cohorte = dplyr::n(),
    .groups="drop"
  )


# =========================
# 10) Join population (sur code_postal)
# =========================
pop <- pop_raw %>%
  mutate(
    code_postal = pad_cp(code_postal),
    population  = to_num(population)
  ) %>%
  filter(!is.na(code_postal), !is.na(population), population > 0) %>%
  select(code_postal, population) %>%
  distinct()


df <- lam_by %>%
  left_join(pop, by = "code_postal") %>%
  filter(!is.na(population), population > 0)


if (nrow(df) == 0) stop("❌ 0 ligne après jointure population. Vérifie population_commune_cp.csv.")


message("✔ Lignes (expo x CP) avec population : ", nrow(df))


# =========================
# 11) Incidence /100k
# =========================
df <- df %>%
  mutate(
    nb_years = nb_years,
    incidence_annuelle_100k = (n_LAM / (population * nb_years)) * 100000,
    incidence_cumulee_100k  = (n_LAM / population) * 100000
  )


# =========================
# 12) Comparaison (wide + IRR)
# =========================
comp <- df %>%
  select(expo_grp, code_postal, commune_nom, population, n_LAM, incidence_annuelle_100k) %>%
  tidyr::pivot_wider(
    names_from = expo_grp,
    values_from = c(n_LAM, incidence_annuelle_100k),
    names_sep = "__"
  ) %>%
  mutate(
    irr_Q3Q4_vs_Q1Q2 = incidence_annuelle_100k__Q3_Q4 / incidence_annuelle_100k__Q1_Q2
  )


# =========================
# 13) QC
# =========================
qc <- tibble::tibble(
  periode = periode_txt,
  n_lignes = nrow(df),
  pop_min = min(df$population, na.rm=TRUE),
  pop_med = median(df$population, na.rm=TRUE),
  pop_max = max(df$population, na.rm=TRUE),
  nLAM_total = sum(df$n_LAM, na.rm=TRUE),
  inc_ann_min = min(df$incidence_annuelle_100k, na.rm=TRUE),
  inc_ann_med = median(df$incidence_annuelle_100k, na.rm=TRUE),
  inc_ann_p95 = as.numeric(quantile(df$incidence_annuelle_100k, 0.95, na.rm=TRUE)),
  inc_ann_max = max(df$incidence_annuelle_100k, na.rm=TRUE)
)


aberrantes <- df %>%
  arrange(desc(incidence_annuelle_100k)) %>%
  slice_head(n = 30)


df_flag <- df %>%
  mutate(flag_small_pop = population < 2000)


# =========================
# 14) Export résultats tableaux
# =========================
readr::write_csv(pop_raw, file.path(res_dir, "population_commune_cp.csv"))
readr::write_csv(df_flag, file.path(res_dir, "table_incidence_LAM_par_commune.csv"))
readr::write_csv(comp, file.path(res_dir, "comparaison_Q1Q2_vs_Q3Q4_par_commune.csv"))
readr::write_csv(qc, file.path(res_dir, "QC_resume.csv"))
readr::write_csv(aberrantes, file.path(res_dir, "QC_top30_incidence_annuelle.csv"))


# =========================
# 15) Agrégation globale (Q1_Q2 vs Q3_Q4)
# =========================
stopifnot(all(c("expo_grp","n_LAM","population","nb_years") %in% names(df)))


agg <- df %>%
  mutate(expo_grp = ifelse(expo_grp %in% c("Q1","Q2","Q1_Q2"), "Q1_Q2", "Q3_Q4")) %>%
  group_by(expo_grp) %>%
  summarise(
    cases = sum(n_LAM, na.rm=TRUE),
    py = sum(population * nb_years, na.rm=TRUE),
    .groups="drop"
  ) %>%
  mutate(
    expo_grp = factor(expo_grp, levels=c("Q1_Q2","Q3_Q4")),
    rate = cases / py,
    inc_100k = rate * 100000
  )


# =========================
# 16) IC95% Poisson exact (incidence)
# =========================
poisson_ci <- function(k, py){
  lo <- if(k==0) 0 else qchisq(0.025, 2*k) / 2
  hi <- qchisq(0.975, 2*(k+1)) / 2
  c(lo/py, hi/py)
}
ci <- mapply(poisson_ci, agg$cases, agg$py)
agg$inc_lo_100k <- ci[1,] * 100000
agg$inc_hi_100k <- ci[2,] * 100000


# =========================
# 17) RR + IC95% + p-value
# =========================
a1 <- agg %>% filter(expo_grp=="Q1_Q2")
a2 <- agg %>% filter(expo_grp=="Q3_Q4")


pt <- poisson.test(
  x = c(a2$cases, a1$cases),
  T = c(a2$py, a1$py),
  r = 1
)


RR   <- unname(pt$estimate)
RRlo <- unname(pt$conf.int[1])
RRhi <- unname(pt$conf.int[2])
pval <- pt$p.value


p_txt <- formatC(pval, format="e", digits=2)
p_txt <- gsub("e", " ×10^", p_txt)
p_txt <- gsub("\\^-(0+)", "^-", p_txt)
p_txt <- gsub("\\^\\+(0+)", "^",  p_txt)


annot <- paste0(
  "RR ", round(RR,2),
  " (", round(RRlo,2), "–", round(RRhi,2), ")",
  "\np=", p_txt
)


# Export résumé global
